#!/usr/bin/env bash
# pclaude — run Claude Code inside a Podman container, scoped to the current directory.
#
# Every argument is passed straight through to `claude`. The launcher's own
# options are namespaced with --pclaude-* so they can never collide.
set -euo pipefail

# Fully qualified so Podman resolves this locally instead of querying registries.
IMAGE="${PCLAUDE_IMAGE:-localhost/pclaude}"
SHARE="${PCLAUDE_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/pclaude}"
MODE="run"

die() { printf 'pclaude: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: pclaude [--pclaude-*] [claude args...]

Everything that is not a --pclaude-* option goes to Claude Code untouched:
  pclaude                       Interactive session in the current directory
  pclaude -p "fix the tests"    Print mode
  pclaude --model opus mcp list Any claude flag or subcommand

Launcher options (before the claude args):
  --pclaude-build    Build the image
  --pclaude-update   Rebuild it from scratch (--pull --no-cache)
  --pclaude-shell    Open a shell in the container instead of Claude
  --pclaude-help     This message

Environment:
  PCLAUDE_IMAGE     Image name             (default: localhost/pclaude)
  PCLAUDE_HOME      Dir holding Dockerfile (default: ~/.local/share/pclaude)
  PCLAUDE_ARGS      Extra podman run args  (e.g. "-v /data:/data:z -e FOO=bar")
  PCLAUDE_NO_YOLO   Set to 1 to drop --dangerously-skip-permissions
  PCLAUDE_RELABEL   SELinux mount label: auto (default), z, Z or off
EOF
}

build_image() {
  [ -f "$SHARE/Dockerfile" ] || die "no Dockerfile in $SHARE — re-run install.sh from the repo"
  podman build -t "$IMAGE" "$@" "$SHARE"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --pclaude-help)   usage; exit 0 ;;
    --pclaude-build)  MODE="build"; shift ;;
    --pclaude-update) MODE="update"; shift ;;
    --pclaude-shell)  MODE="shell"; shift ;;
    *) break ;;
  esac
done

case "$MODE" in
  build)  build_image "$@"; exit 0 ;;
  update) build_image --pull --no-cache "$@"; exit 0 ;;
esac

if ! podman image exists "$IMAGE"; then
  echo "pclaude: image $IMAGE not found, building it once..." >&2
  build_image
fi

# Guard against relabelling / exposing an entire home directory by accident.
case "$PWD" in
  /) die "refusing to run in /" ;;
  "$HOME") [ "${PCLAUDE_ALLOW_HOME:-}" = 1 ] || die "refusing to mount all of \$HOME (set PCLAUDE_ALLOW_HOME=1 to override)" ;;
esac

# Claude Code stores its state here; create both so Podman doesn't make them dirs.
mkdir -p "$HOME/.claude"
[ -e "$HOME/.claude.json" ] || echo '{}' > "$HOME/.claude.json"

# One login for host and container. Claude Code reads ~/.claude/.credentials.json on
# Linux but keeps the token in the login Keychain on macOS, which the container cannot
# reach — so mirror the host's Keychain login into that file on every run. The host
# stays the single place you ever run /login.
if [ "$(uname -s)" = "Darwin" ]; then
  creds="$HOME/.claude/.credentials.json"
  if security find-generic-password -s 'Claude Code-credentials' -w >"$creds.new" 2>/dev/null \
     && [ -s "$creds.new" ]; then
    chmod 600 "$creds.new"
    mv "$creds.new" "$creds"
  else
    rm -f "$creds.new"
    [ -s "$creds" ] || die "not logged in — run 'claude /login' on the host, then rerun pclaude"
  fi
fi

# SELinux hosts (Fedora, RHEL...) need a relabel suffix on bind mounts:
#   PCLAUDE_RELABEL=z    shared label, lets concurrent sessions share ~/.claude
#   PCLAUDE_RELABEL=Z    private label, stricter, for one session at a time
#   PCLAUDE_RELABEL=off  plain bind mounts
relabel="${PCLAUDE_RELABEL:-auto}"
if [ "$relabel" = auto ]; then
  if [ -f /sys/fs/selinux/enforce ]; then relabel=z; else relabel=off; fi
fi
case "$relabel" in
  z|Z) Z="$relabel" ;;
  off) Z="" ;;
  *)   die "PCLAUDE_RELABEL must be z, Z, off or auto" ;;
esac

# The project keeps its host path inside the container, so Claude's per-project
# session history is keyed the same way it is on the host.
args=(
  --rm --interactive --tty
  --hostname pclaude
  --userns "keep-id:uid=1000,gid=1000"
  --volume "$PWD:$PWD${Z:+:$Z}"
  --workdir "$PWD"
  --volume "$HOME/.claude:/home/node/.claude${Z:+:$Z}"
  --volume "$HOME/.claude.json:/home/node/.claude.json${Z:+:$Z}"
)

if [ -f "$HOME/.gitconfig" ]; then
  args+=(--volume "$HOME/.gitconfig:/home/node/.gitconfig:ro${Z:+,$Z}")
fi

for var in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_MODEL \
           CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX GH_TOKEN TERM COLORTERM; do
  if [ -n "${!var-}" ]; then args+=(--env "$var=${!var}"); fi
done

# Word-split PCLAUDE_ARGS the way a shell would.
if [ -n "${PCLAUDE_ARGS:-}" ]; then
  read -r -a extra <<<"$PCLAUDE_ARGS"
  args+=("${extra[@]}")
fi

# Name the command explicitly, so any other one can replace it.
if [ "$MODE" = "shell" ]; then
  exec podman run "${args[@]}" "$IMAGE" bash "$@"
fi

[ "${PCLAUDE_NO_YOLO:-}" = 1 ] || set -- --dangerously-skip-permissions "$@"

exec podman run "${args[@]}" "$IMAGE" claude "$@"
